<?xml version="1.0" encoding="UTF-8"?>
<!-- Replaces the packaged file, so keep "Open Terminal Here" -->
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<unique-id>1-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Open a terminal in this folder</description>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>document-save</icon>
	<name>Download to my computer</name>
	<unique-id>nectar-vds-download</unique-id>
	<command>/usr/local/bin/vds-download %F</command>
	<description>Send the selected files to your web browser as a download</description>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
</actions>
